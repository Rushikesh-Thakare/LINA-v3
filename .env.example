# LINA v3 — Environment Variables
# Copy this file to .env and fill in your values.

# ── AI API Keys ───────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_key_here
GROQ_API_KEY=your_key_here

# ── Model Selection ───────────────────────────────────────────────────────────
# Whisper model size: tiny.en | base.en | small.en | medium.en
WHISPER_MODEL=small.en

# Piper TTS voice (model file must exist under PIPER_MODEL_PATH/)
PIPER_VOICE=en_US-amy-medium


# LLM model names (optional overrides)
# CLAUDE_MODEL=claude-haiku-4-5
# GROQ_MODEL=llama-3.1-8b-instant

# ── Paths (optional — defaults to ~/.local/share/lina/) ──────────────────────
# PIPER_MODEL_PATH=~/.local/share/lina/models/piper
# VOSK_FALLBACK_MODEL=~/.local/share/lina/models/vosk
# HISTORY_DIR=~/.local/share/lina/history
# LOG_DIR=~/.local/share/lina/logs

# ── Wake Word ─────────────────────────────────────────────────────────────────
# Must be a valid openWakeWord built-in name OR path to a custom .onnx file.
# Built-in options: alexa | hey_jarvis | hey_mycroft | ok_nabu | hey_rhasspy
ENABLE_WAKE_WORD=true
WAKE_WORD=hey_jarvis
DISPLAY_WAKE_PHRASE=Hey LINA
OWW_THRESHOLD=0.5

# ── Audio ─────────────────────────────────────────────────────────────────────
# VAD_AGGRESSIVENESS=2          # 0 (least) to 3 (most aggressive)
# MAX_RECORDING_SECONDS=10
# SILENCE_THRESHOLD_SECONDS=1.5

# ── Security ──────────────────────────────────────────────────────────────────
# PARANOID_MODE=false           # Confirm before every script execution
# AUDIT_MODE=true               # SHA-256 hash logging for executed scripts
# ENABLE_NETWORK_COMMANDS=true
# ENABLE_FILE_COMMANDS=true
# ENABLE_SYSTEM_COMMANDS=true

# ── History ───────────────────────────────────────────────────────────────────
# HISTORY_RETENTION_DAYS=7
