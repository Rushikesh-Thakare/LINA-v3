# LINA v3 — Environment Variables
# Copy this file to .env and fill in your API key.

# ── AI (required) ─────────────────────────────────────────────────────────────
# Free key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# ── LLM model (optional override) ────────────────────────────────────────────
# GROQ_MODEL=llama-3.1-8b-instant     # default (fast, free)
# GROQ_MODEL=llama-3.3-70b-versatile  # smarter, still free

# ── Whisper STT model (optional) ─────────────────────────────────────────────
# WHISPER_MODEL=small.en    # tiny.en | base.en | small.en | medium.en

# ── Piper TTS voice (optional) ───────────────────────────────────────────────
# PIPER_VOICE=en_US-amy-medium

# ── Paths (optional — defaults to ~/.local/share/lina/) ──────────────────────
# PIPER_MODEL_PATH=~/.local/share/lina/models/piper
# HISTORY_DIR=~/.local/share/lina/history
# LOG_DIR=~/.local/share/lina/logs

# ── Wake Word ─────────────────────────────────────────────────────────────────
# Built-in: alexa | hey_jarvis | hey_mycroft | ok_nabu | hey_rhasspy
ENABLE_WAKE_WORD=true
WAKE_WORD=hey_jarvis
DISPLAY_WAKE_PHRASE=Hey LINA
OWW_THRESHOLD=0.5

# ── Audio (optional) ──────────────────────────────────────────────────────────
# VAD_AGGRESSIVENESS=2          # 0–3 (2 is recommended)
# MAX_RECORDING_SECONDS=10
# SILENCE_THRESHOLD_SECONDS=1.5

# ── Security (optional) ───────────────────────────────────────────────────────
# PARANOID_MODE=false
# AUDIT_MODE=true
# ENABLE_NETWORK_COMMANDS=true
# ENABLE_FILE_COMMANDS=true
# ENABLE_SYSTEM_COMMANDS=true

# ── History (optional) ────────────────────────────────────────────────────────
# HISTORY_RETENTION_DAYS=7
